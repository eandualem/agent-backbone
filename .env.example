# GitHub personal access token (for REST API queries)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gateway port (must match ngrok config)
GATEWAY_PORT=9877

# Webhook secret (shared with GitHub webhook config)
WEBHOOK_SECRET=your-webhook-secret-here

# GitHub repo for issue tracking
GITHUB_OWNER=eandualem
GITHUB_REPO=orchestration

# PostgreSQL database (matches docker-compose.yml defaults)
# Used by AppSettings (BACKBONE_ prefix) for env var overlay
BACKBONE_DATABASE_HOST=localhost
BACKBONE_DATABASE_PORT=5435
BACKBONE_DATABASE_USER=backbone
BACKBONE_DATABASE_PASSWORD=backbone
BACKBONE_DATABASE_NAME=backbone
