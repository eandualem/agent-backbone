# Secrets for agent-backbone. `backbone init` writes this file into the data
# directory (~/.local/share/agent-backbone/.env) with a generated API key.
# Everything else is a setting: `backbone config list`.

# Required: bearer token for the REST/Socket.IO API
BACKBONE_API_KEY=

# GitHub — a token is the simplest option (PAT with repo scope, or `gh auth token`)
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=            # setting this switches intake from poll to webhook

# GitHub App (alternative to GITHUB_TOKEN)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=

# Telegram bot token from @BotFather
# TELEGRAM_TOKEN=

# Where the data directory is (default ~/.local/share/agent-backbone)
# BACKBONE_DATA_DIR=

# PostgreSQL instead of the SQLite file in the data directory
# BACKBONE_DATABASE_URL=postgresql+asyncpg://backbone:backbone@localhost:5435/backbone
