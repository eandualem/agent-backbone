# Copy to .env next to backbone.toml. `backbone init` generates this for you.

# Required: API key for the REST/Socket.IO API (generate: openssl rand -base64 32)
BACKBONE_API_KEY=

# GitHub — a token is the simplest option (PAT with repo scope, or `gh auth token`)
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=            # required when [github] mode = "webhook"

# GitHub App (alternative to GITHUB_TOKEN)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=

# Telegram bot token from @BotFather
# TELEGRAM_TOKEN=

# Optional overrides
# BACKBONE_CONFIG=/path/to/backbone.toml
# BACKBONE_DATA_DIR=~/.local/share/agent-backbone
# BACKBONE_DATABASE_URL=postgresql+asyncpg://backbone:backbone@localhost:5435/backbone
