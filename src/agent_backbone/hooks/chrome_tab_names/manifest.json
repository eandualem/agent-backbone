{
  "manifest_version": 3,
  "name": "Agent Backbone tab group names",
  "version": "1.0.0",
  "description": "Names the Chrome tab groups Claude-in-Chrome opens for Backbone agents after the agent that owns them.",
  "key": "",
  "permissions": [
    "tabGroups",
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
